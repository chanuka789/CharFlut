---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminCard from '@/components/admin/AdminCard.astro';
import Notice from '@/components/admin/Notice.astro';
import Icon from '@/components/ui/Icon.astro';
import { configuredProviders } from '@/lib/providers';
import { db, getEnv } from '@/lib/server/db';

const env = getEnv();
const providers = configuredProviders(env);
let lastSync: { at: string; report: { provider: string; imported: number; updated: number; error?: string }[] } | null = null;
let events: { provider: string; type: string; received_at: string; processed_at: string | null; error: string | null }[] = [];
try {
  const row = await db()?.prepare("SELECT value_json FROM settings WHERE key = 'last_sync'").first<{ value_json: string }>();
  lastSync = row ? JSON.parse(row.value_json) : null;
  events = (await db()?.prepare('SELECT provider, type, received_at, processed_at, error FROM webhook_events ORDER BY received_at DESC LIMIT 12').all<(typeof events)[number]>())?.results ?? [];
} catch {
  /* migrations not applied */
}
const site = env.SITE_URL;
const hook = (p: string) => `${site}/api/webhooks/${p}/${env.WEBHOOK_SECRET_PATH ? '••••••••' : '<WEBHOOK_SECRET_PATH>'}`;
const info = {
  printify: {
    name: 'Printify',
    api: 'v1 · 600 req/min',
    setup: ['Create a shop with the API / custom integration option', 'Personal Access Token with shops, catalog, products, orders, uploads, webhooks scopes (valid 1 year)', 'wrangler secret put PRINTIFY_API_TOKEN and PRINTIFY_SHOP_ID'],
    events: 'product:publish:started, product:updated, product:deleted, order:* shipment events',
  },
  printful: {
    name: 'Printful',
    api: 'v1 sync products · v2 orders, shipping, mockups · ~120 req/min',
    setup: ['Create a "Manual order platform / API" store', 'Create a private token for that store', 'wrangler secret put PRINTFUL_API_TOKEN (and PRINTFUL_STORE_ID if the token covers several stores)'],
    events: 'order_created, order_updated, order_failed, order_cancelled, shipment_sent, catalog_price_changed, catalog_stock_updated',
  },
} as const;
const done = Astro.url.searchParams.get('done');
const err = Astro.url.searchParams.get('error');
---

<AdminLayout title="Providers" description="Printify and Printful connections, sync and webhook health">
  <form slot="actions" method="post" action="/api/admin/sync"><button class="btn btn-primary btn-sm"><Icon name="refresh" size={16} /><span>Sync now</span></button></form>
  {done && <Notice>Sync finished.</Notice>}
  {err && <Notice tone="danger">{err}</Notice>}
  <div class="grid gap-3 lg:grid-cols-2">
    {
      providers.map((p) => {
        const i = info[p.id];
        const rep = lastSync?.report.find((r) => r.provider === p.id);
        return (
          <AdminCard title={i.name} subtitle={i.api}>
            <span slot="actions" class={p.ok ? 'badge badge-success' : 'badge badge-warn'}>{p.ok ? 'Connected' : 'Not set up'}</span>
            <dl class="grid gap-2 text-sm">
              <div class="flex justify-between gap-4"><dt class="text-muted">Last sync</dt><dd>{lastSync ? new Date(lastSync.at).toLocaleString('en-GB') : 'Never'}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-muted">Result</dt><dd>{rep ? (rep.error ? <span class="text-danger">{rep.error}</span> : `${rep.imported} new, ${rep.updated} updated`) : '—'}</dd></div>
              <div class="grid gap-1"><dt class="text-muted">Webhook URL</dt><dd class="break-all font-mono text-xs">{hook(p.id)}</dd></div>
              <div class="grid gap-1"><dt class="text-muted">Events</dt><dd class="text-xs">{i.events}</dd></div>
            </dl>
            {!p.ok && (
              <ol class="mt-4 list-decimal space-y-1 pl-5 text-sm text-muted">
                {i.setup.map((s) => <li>{s}</li>)}
              </ol>
            )}
          </AdminCard>
        );
      })
    }
  </div>
  <AdminCard title="Recent webhook events" class="mt-3" flush>
    {
      events.length ? (
        <table class="table table-stack">
          <thead><tr><th>Provider</th><th>Event</th><th>Received</th><th>Result</th></tr></thead>
          <tbody>
            {events.map((e) => (
              <tr>
                <td data-label="Provider" class="capitalize">{e.provider}</td>
                <td data-label="Event" class="font-mono text-xs">{e.type}</td>
                <td data-label="Received" class="text-muted">{e.received_at}</td>
                <td data-label="Result">{e.error ? <span class="badge badge-danger">Error</span> : e.processed_at ? <span class="badge badge-success">Processed</span> : <span class="badge">Pending</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="px-5 pb-5 text-sm text-muted">No events yet.</p>
      )
    }
  </AdminCard>
</AdminLayout>
