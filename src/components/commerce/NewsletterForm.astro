---
/** Newsletter sign-up. Posts to /api/newsletter, works without JS (redirects back), enhanced with fetch. */
interface Props {
  class?: string;
  source: string;
  dark?: boolean;
}
const { class: className, source } = Astro.props;
const id = `nl-${source}`;
---

<form method="post" action="/api/newsletter" class:list={['newsletter-form', className]} data-newsletter>
  <input type="hidden" name="source" value={source} />
  <div class="flex flex-col gap-2 sm:flex-row">
    <label for={id} class="sr-only">Email address</label>
    <input
      id={id}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@email.com"
      class="input flex-1"
    />
    <button type="submit" class="btn btn-dark">
      <span>Join</span>
    </button>
  </div>
  <p class="field-hint mt-2" data-msg aria-live="polite">By joining you agree to our <a href="/legal/privacy" class="underline">privacy policy</a>.</p>
</form>

<script>
  import './newsletter-client';
</script>
