---
/**
 * Shop listing used by /shop and /shop/[category] (plan 04): title band with count, filters (category, size,
 * colour, price, fit), sort, responsive grid. Sidebar on desktop, bottom sheet on phones and tablets.
 */
import PageHeader from '@/components/ui/PageHeader.astro';
import ProductGrid from './ProductGrid.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import type { CategorySlug, Product } from '@/lib/types';

interface Props {
  title: string;
  lead: string;
  products: Product[];
  category?: CategorySlug;
  crumbs: { label: string; href?: string }[];
  outlineWord?: string;
}
const { title, lead, products, category, crumbs, outlineWord } = Astro.props;
const sort = Astro.url.searchParams.get('sort') ?? 'new';

const colorMap = new Map<string, { id: string; name: string; hex: string }>();
products.forEach((p) => p.colors.forEach((c) => colorMap.set(c.id, c)));
const colors = [...colorMap.values()];
const sizes = ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'];
---

<PageHeader title={title} lead={lead} crumbs={crumbs} outlineWord={outlineWord}>
  <p class="t-label t-muted" data-filter-count>{products.length} products</p>
</PageHeader>

<section class="bg-bg pb-[var(--section-y)]">
  <div class="cf-container">
    <!-- Toolbar -->
    <div class="sticky top-[calc(var(--header-h)+var(--bar-h))] z-30 -mx-[var(--gutter)] mb-6 flex items-center justify-between gap-3 border-y border-line bg-bg/90 px-[var(--gutter)] py-3 backdrop-blur lg:static lg:mx-0 lg:border-x-0 lg:bg-transparent lg:px-0">
      <button type="button" class="btn btn-outline btn-sm lg:hidden" data-filter-open aria-controls="filters" aria-expanded="false">
        <Icon name="filter" size={18} /> <span>Filter</span>
        <span class="badge badge-brand !h-5 !px-1.5" data-filter-active hidden></span>
      </button>
      <p class="t-small t-muted hidden lg:block">Printed to order · Ships in 2–5 days</p>
      <label class="flex items-center gap-2 text-sm">
        <span class="t-muted hidden sm:inline">Sort</span>
        <select name="sort" form="filters-form" class="input !min-h-10 !w-auto !py-2 text-sm" aria-label="Sort products">
          <option value="new" selected={sort === 'new'}>Newest</option>
          <option value="popular" selected={sort === 'popular'}>Most popular</option>
          <option value="price-asc" selected={sort === 'price-asc'}>Price: low to high</option>
          <option value="price-desc" selected={sort === 'price-desc'}>Price: high to low</option>
        </select>
      </label>
    </div>

    <div class="grid gap-10 lg:grid-cols-[240px_1fr] xl:grid-cols-[260px_1fr]">
      <!-- Filters: bottom sheet below lg, sidebar at lg+ -->
      <aside id="filters" class="filters" data-open="false" aria-label="Filters">
        <div class="filters-scrim lg:hidden" data-filter-close></div>
        <form id="filters-form" data-filters class="filters-sheet" onsubmit="return false">
          <div class="mb-2 flex items-center justify-between lg:hidden">
            <p class="font-display text-xl font-black uppercase">Filter</p>
            <button type="button" class="icon-btn" data-filter-close aria-label="Close filters"><Icon name="close" /></button>
          </div>

          {
            !category && (
              <fieldset class="filter-group">
                <legend>Category</legend>
                <div class="flex flex-wrap gap-2">
                  {['tees', 'hoodies'].map((c) => (
                    <label class="chip-check">
                      <input type="checkbox" name="category" value={c} class="sr-only" />
                      <span class="chip capitalize">{c}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }
          <fieldset class="filter-group">
            <legend>Fit</legend>
            <div class="flex flex-wrap gap-2">
              {
                ['oversized', 'regular'].map((f) => (
                  <label class="chip-check">
                    <input type="checkbox" name="fit" value={f} class="sr-only" />
                    <span class="chip capitalize">{f}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="filter-group">
            <legend>Size</legend>
            <div class="grid grid-cols-4 gap-2">
              {
                sizes.map((s) => (
                  <label class="chip-check">
                    <input type="checkbox" name="size" value={s} class="sr-only" />
                    <span class="chip w-full !min-w-0 !px-0">{s}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="filter-group">
            <legend>Colour</legend>
            <div class="flex flex-wrap gap-3">
              {
                colors.map((c) => (
                  <label class="swatch-check flex flex-col items-center gap-1.5 text-xs" title={c.name}>
                    <input type="checkbox" name="color" value={c.id} class="sr-only" />
                    <span class="swatch" style={`--swatch:${c.hex}`} />
                    <span>{c.name}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="filter-group">
            <legend>Max price</legend>
            <select name="max" class="input">
              <option value="">Any price</option>
              <option value="35">Under 35</option>
              <option value="50">Under 50</option>
              <option value="70">Under 70</option>
            </select>
          </fieldset>
          <div class="sticky bottom-0 mt-4 flex gap-2 bg-bg pt-3 lg:static">
            <Button type="reset" variant="ghost" size="sm" class="flex-1 lg:flex-none">Clear all</Button>
            <Button variant="dark" size="sm" class="flex-1 lg:hidden" data-filter-close>Show results</Button>
          </div>
        </form>
      </aside>

      <div>
        <div data-filter-grid>
          <ProductGrid products={products} columns={3} />
        </div>
        <div data-filter-empty hidden class="panel py-16 text-center">
          <p class="t-h3">No products match these filters.</p>
          <button type="reset" form="filters-form" class="btn btn-dark mt-6"><span>Clear filters</span></button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .filter-group {
    border: 0;
    border-bottom: 1px solid var(--color-line);
    padding: 0 0 20px;
    margin: 0 0 20px;
  }
  .filter-group legend {
    font-weight: 700;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
    padding: 0;
  }
  .chip-check input:checked + .chip {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }
  .chip-check input:focus-visible + .chip,
  .swatch-check input:focus-visible + .swatch {
    box-shadow: var(--focus-ring);
  }
  .swatch-check {
    cursor: pointer;
  }
  .swatch-check input:checked + .swatch::after {
    border-color: var(--color-ink);
  }
  [data-filter-grid] [hidden] {
    display: none;
  }

  @media (max-width: 1023px) {
    .filters-scrim {
      position: fixed;
      inset: 0;
      z-index: 85;
      background: rgb(17 17 17 / 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-base);
    }
    .filters-sheet {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 86;
      max-height: 86dvh;
      overflow-y: auto;
      padding: 20px var(--gutter) max(16px, env(safe-area-inset-bottom));
      background: var(--color-bg);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      transform: translateY(100%);
      transition: transform 480ms var(--ease-out);
    }
    .filters[data-open='true'] .filters-scrim {
      opacity: 1;
      pointer-events: auto;
    }
    .filters[data-open='true'] .filters-sheet {
      transform: none;
    }
  }
  @media (min-width: 1024px) {
    .filters-sheet {
      position: sticky;
      top: calc(var(--header-h) + var(--bar-h) + 24px);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('filters');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";
    const opener = document.querySelector<HTMLButtonElement>('[data-filter-open]');
    const set = (open: boolean) => {
      root.dataset.open = String(open);
      opener?.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) window.__cfLenis?.stop();
      else window.__cfLenis?.start();
    };
    opener?.addEventListener('click', () => set(true));
    root.querySelectorAll('[data-filter-close]').forEach((b) => b.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && root.dataset.open === 'true' && set(false));
  });
</script>
