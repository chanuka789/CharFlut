---
/** Responsive product grid: 2 columns on phones, 3 on tablets, 4 on desktop (plan 04, Shop). */
import ProductCard from './ProductCard.astro';
import type { Product } from '@/lib/types';

interface Props {
  products: Product[];
  columns?: 3 | 4;
  id?: string;
}
const { products, columns = 4, id } = Astro.props;
---

<div
  id={id}
  data-stagger
  class:list={[
    'grid grid-cols-2 gap-x-3 gap-y-9 sm:gap-x-5 md:grid-cols-3 md:gap-y-12',
    columns === 4 && 'xl:grid-cols-4',
  ]}
>
  {products.map((p, i) => <ProductCard product={p} index={i} />)}
</div>
