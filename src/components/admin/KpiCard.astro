---
/** Stat tile: label, hero number, optional note. A single headline number is a tile, not a chart. */
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';

interface Props {
  label: string;
  value: string;
  note?: string;
  icon?: IconName;
  tone?: 'default' | 'alert';
  href?: string;
}
const { label, value, note, icon, tone = 'default', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['panel !p-5 block transition-colors', tone === 'alert' && 'ring-1 ring-danger/60', href && 'hover:bg-[#232323]']}>
  <div class="flex items-center justify-between text-muted">
    <p class="t-label">{label}</p>
    {icon && <Icon name={icon} size={18} />}
  </div>
  <p class="mt-3 font-display text-[clamp(1.75rem,2.4vw,2.25rem)] font-black leading-none tabular-nums">{value}</p>
  {note && <p class:list={['mt-2 text-sm', tone === 'alert' ? 'text-danger' : 'text-muted']}>{note}</p>}
</Tag>
