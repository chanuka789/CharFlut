---
import Icon from './Icon.astro';
import Button from './Button.astro';
import type { IconName } from './icons';

interface Props {
  icon?: IconName;
  title: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const { icon = 'box', title, body, ctaLabel, ctaHref } = Astro.props;
---

<div class="panel flex flex-col items-center gap-4 py-16 text-center">
  <span class="grid size-14 place-items-center rounded-full bg-bg"><Icon name={icon} size={26} /></span>
  <h2 class="t-h3">{title}</h2>
  {body && <p class="t-muted max-w-md">{body}</p>}
  {ctaLabel && ctaHref && <Button href={ctaHref} variant="dark" arrow>{ctaLabel}</Button>}
  <slot />
</div>
