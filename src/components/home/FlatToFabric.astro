---
/**
 * "From flat to fabric" (plan 04 #5): Design, Print, Delivered, each with a short looping animation.
 * Tells the print-on-demand story honestly. Sticky title on desktop, stacked on mobile.
 */
import Garment from '@/components/product/Garment';
import { PrintArt } from '@/components/product/Garment';

const steps = [
  { n: '01', title: 'Design', body: 'Every piece starts as flat artwork, drawn in-house on the CharFlut grid.' },
  { n: '02', title: 'Print', body: 'When you order, your garment is printed just for you by our print partners in the US and UK. No piles of unsold stock.' },
  { n: '03', title: 'Delivered', body: 'It ships in 2–5 working days with tracking, straight to your door.' },
];
---

<section class="cf-section bg-surface" aria-labelledby="f2f-title">
  <div class="cf-container grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+var(--bar-h)+48px)]">
        <p class="t-label t-muted mb-4" data-reveal>How it works</p>
        <h2 id="f2f-title" class="t-h1" data-split>From flat to fabric.</h2>
        <p class="t-lead mt-5 max-w-md" data-reveal>Made to order means less waste and more care for each piece. Here is the whole journey.</p>
      </div>
    </div>
    <ol class="space-y-3 sm:space-y-5 lg:col-span-7">
      {
        steps.map((s, i) => (
          <li class="panel-line grid items-center gap-6 sm:grid-cols-[1fr_200px] lg:grid-cols-[1fr_240px]" data-reveal>
            <div>
              <p class="font-display text-sm font-black text-muted">{s.n}</p>
              <h3 class="t-h2 mt-2">{s.title}</h3>
              <p class="t-muted mt-3 max-w-md">{s.body}</p>
            </div>
            <div class="relative aspect-square overflow-hidden rounded-[var(--radius-md)] bg-surface" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="-100 -100 200 200" class="step-design h-full w-full">
                  <g stroke="#d9d9d6" stroke-width="0.6">
                    {Array.from({ length: 9 }).map((_, k) => (
                      <>
                        <line x1={-100 + k * 25} y1="-100" x2={-100 + k * 25} y2="100" />
                        <line x1="-100" y1={-100 + k * 25} x2="100" y2={-100 + k * 25} />
                      </>
                    ))}
                  </g>
                  <g class="draw" transform="scale(0.9)">
                    <PrintArt design="sunburst" ink="#111111" bg="#F4F4F1" />
                  </g>
                </svg>
              )}
              {i === 1 && (
                <div class="step-print absolute inset-[10%]">
                  <Garment category="tees" color="#141414" ink="#FFC800" design="monogram" className="absolute inset-0 h-full w-full" />
                  <div class="print-blank absolute inset-0">
                    <Garment category="tees" color="#141414" ink="#141414" design="monogram" className="h-full w-full" />
                  </div>
                  <span class="print-line absolute inset-x-[-10%] h-[3px] bg-brand shadow-[0_0_24px_6px_rgba(255,200,0,0.7)]" />
                </div>
              )}
              {i === 2 && (
                <div class="step-ship absolute inset-0 grid place-items-center">
                  <div class="box relative size-[46%]">
                    <div class="absolute inset-0 rounded-[10px] bg-[#c8a978]" />
                    <div class="absolute inset-x-0 top-[38%] h-[14%] bg-[#b08f5c]" />
                    <img src="/brand/icon.svg" alt="" class="absolute bottom-[12%] right-[12%] size-[26%]" />
                  </div>
                  <span class="ship-line absolute bottom-[22%] left-0 h-[2px] w-full bg-[repeating-linear-gradient(90deg,#111_0_10px,transparent_10px_20px)] opacity-25" />
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .step-design .draw {
    animation: pop 3.2s var(--ease-out) infinite;
    transform-origin: center;
  }
  @keyframes pop {
    0%,
    10% {
      opacity: 0;
      transform: scale(0.6) rotate(-20deg);
    }
    35%,
    85% {
      opacity: 1;
      transform: scale(0.9) rotate(0);
    }
    100% {
      opacity: 0;
    }
  }
  .print-blank {
    animation: reveal 3.2s linear infinite;
  }
  .print-line {
    animation: sweep 3.2s linear infinite;
  }
  @keyframes reveal {
    0% {
      clip-path: inset(0 0 0 0);
    }
    70%,
    100% {
      clip-path: inset(100% 0 0 0);
    }
  }
  @keyframes sweep {
    0% {
      top: 0;
      opacity: 1;
    }
    70% {
      top: 100%;
      opacity: 1;
    }
    71%,
    100% {
      opacity: 0;
    }
  }
  .step-ship .box {
    animation: ship 3.2s var(--ease-in-out) infinite;
  }
  @keyframes ship {
    0% {
      transform: translateX(-160%);
    }
    35%,
    65% {
      transform: translateX(0) translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
    100% {
      transform: translateX(160%);
    }
  }
</style>
