# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://charflut:your_password@localhost:5432/charflut"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Public URL of your app (required for OAuth callbacks)
NEXTAUTH_URL="https://your-domain.com"

# A random string — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_me_with_a_random_32_char_string"

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# If left blank, Google sign-in button will still render but credentials login works
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Docker Compose ────────────────────────────────────────────────────────────
POSTGRES_USER=charflut
POSTGRES_DB=charflut
POSTGRES_PASSWORD="changeme_in_production"

# Port to expose (default 3000)
PORT=3000
